// IronSurf shell UI — single component, all state driven from Rust.
//
// The Rust side (src/app.rs) owns the real state (tabs, containers, IPC);
// this file renders snapshots pushed through `in` properties and forwards
// user intents through `out` callbacks. Keyboard chords are decided in
// Rust (see `keymap::shortcut_for`), so this file stays dumb.
//
// Note: Slint ids are only visible to descendants, and built-in elements
// cannot declare custom properties — so the two focus() watchers live in
// the small custom components `UrlBar` and `PageSurface` instead.

import { LineEdit, ListView } from "std-widgets.slint";

export struct TabInfo {
    id: int,
    title: string,
    color: color,
    active: bool,
}

export struct ContainerInfo {
    name: string,
    color: color,
    isDefault: bool,
}

/// One context-menu row (labels only; Rust keeps the matching actions and
/// maps the picked index back onto them).
export struct MenuItem {
    label: string,
}

/// One DevTools console row, already reduced by `state::TabState::console_rows`
/// (`level` drives the icon/colour, `text` is `"[source] message"`).
export struct ConsoleRow {
    level: string,
    text: string,
}

/// One DevTools network row: pre-formatted columns (`—` for values the engine
/// never sent); `failed` paints the status cell red with the error text in it.
export struct NetRow {
    method: string,
    url: string,
    status: string,
    size: string,
    time: string,
    failed: bool,
}

/// A tiny borderless toolbar button (cheaper than styled Buttons in rows).
component MiniButton inherits Rectangle {
    in property <string> label: "";
    in property <bool> enabled: true;
    in property <color> tint: #262626;
    callback clicked();
    width: Math.max(22px, lbl.preferred-width + 12px);
    height: 24px;
    bg := Rectangle {
        background: ta.has-hover ? (root.enabled ? #3d3d3d : #2c2c2c) : root.tint;
        border-radius: 4px;
    }
    lbl := Text {
        text: root.label;
        color: root.enabled ? #e8e8e8 : #6a6a6a;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: parent.width;
        height: parent.height;
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

/// URL bar wrapper: bumps `focus-token` (from Rust / Ctrl-L / F6) to grab
/// focus and highlight the whole address, so typing replaces it outright.
component UrlBar inherits Rectangle {
    in property <int> focus-token: 0;
    in-out property<string> text <=> edit.text;
    callback submitted(text: string);
    edit := LineEdit {
        width: parent.width;
        height: parent.height;
        placeholder-text: "Search or enter address — Ctrl-L or F6 to focus";
        accepted(txt) => { root.submitted(txt); }
    }
    // armed on token bumps only (> 0), so clicking out of the bar does not
    // yank focus back
    changed focus-token => {
        if (root.focus-token > 0) {
            edit.focus();
            edit.select-all();
        }
    }
}

/// The page's keyboard focus holder. Every key press is forwarded to Rust
/// (consumed so Slint never beeps); Rust either acts on a browser chord or
/// relays a ToTab::Key to the active tab process.
component PageSurface inherits FocusScope {
    in property <int> focus-token: 0;
    callback key(pressed: bool, text: string, ctrl: bool, shift: bool, alt: bool, meta: bool, repeat: bool);
    changed focus-token => {
        if (root.focus-token > 0) { self.focus(); }
    }
    key-pressed(ev) => {
        root.key(true, ev.text, ev.modifiers.control, ev.modifiers.shift, ev.modifiers.alt, ev.modifiers.meta, ev.repeat);
        return EventResult.accept;
    }
    key-released(ev) => {
        root.key(false, ev.text, ev.modifiers.control, ev.modifiers.shift, ev.modifiers.alt, ev.modifiers.meta, ev.repeat);
        return EventResult.accept;
    }
}

/// One row (or the caption row) of the DevTools network table: Method | URL |
/// Status | Size | Time, laid out with explicit geometry so captions and data
/// lines up, and the URL is the column that absorbs the window's width.
component NetRowCells inherits Rectangle {
    in property <string> method: "";
    in property <string> url: "";
    in property <string> status: "";
    in property <string> bytes: "";
    in property <string> time: "";
    in property <color> cell-color: #cfcfcf;
    in property <color> status-color: root.cell-color;

    m := Text {
        x: 8px; width: 56px; height: parent.height;
        text: root.method; color: root.cell-color;
        vertical-alignment: center; overflow: elide;
    }
    u := Text {
        x: 70px; width: Math.max(60px, parent.width - 320px); height: parent.height;
        text: root.url; color: root.cell-color;
        vertical-alignment: center; overflow: elide;
    }
    s := Text {
        x: parent.width - 236px; width: 100px; height: parent.height;
        text: root.status; color: root.status-color;
        vertical-alignment: center; overflow: elide;
    }
    sz := Text {
        x: parent.width - 132px; width: 66px; height: parent.height;
        text: root.bytes; color: root.cell-color;
        vertical-alignment: center; overflow: elide;
    }
    t := Text {
        x: parent.width - 62px; width: 54px; height: parent.height;
        text: root.time; color: root.cell-color;
        vertical-alignment: center; overflow: elide;
    }
}

export component AppWindow inherits Window {
    title: "IronSurf";
    background: #1f1f1f;
    min-width: 640px;
    min-height: 480px;

    // ------------------------------------------------------------------
    // state pushed from Rust
    // ------------------------------------------------------------------
    in property <[TabInfo]> tabs;
    in property <[ContainerInfo]> containers;
    in property <image> page-image;
    // two-way alias: Rust pushes URLs here and they propagate to the URL bar
    in-out property<string> url-text <=> url-bar.text;
    in property <string> status-text;
    in property <string> sec-glyph: "";
    in property <color> sec-color: #888888;
    in property <string> spinner: " ";
    in property <string> container-label: "";
    in property <bool> can-back: false;
    in property <bool> can-fwd: false;
    in property <bool> manager-open: false;
    in property <int> editing-index: -1;
    in-out property <string> container-edit-text;
    in property <int> selected-container: 0;
    in property <int> active-index: 0;
    // bumped by Rust to move focus programmatically (Ctrl-L / Esc / startup)
    in property <int> focus-url-token: 0;
    in-out property <int> focus-page-token: 0;
    // page area size, read by Rust to send ToTab::Resize
    out property <length> page-width: page.width;
    out property <length> page-height: page.height;
    // right-click context menu (task: context menu): opened by Rust when a
    // tab reports `FromTab::ContextMenu`; (menu-x, menu-y) is in page-area
    // coordinates, items are labels only — Rust maps the picked index onto
    // the real action.
    in property <bool> menu-open: false;
    in property <length> menu-x: 0px;
    in property <length> menu-y: 0px;
    in property <[MenuItem]> menu-items;

    // DevTools panel (task: DevTools UI): bottom-docked over the page area of
    // the *active* tab. Rust owns the open/closed flag (per tab) and the view
    // choice, and pushes the reduced console/network rows on every drain tick
    // while the panel is open.
    in property <bool> devtools-open: false;
    in property <int> devtools-view: 0; // 0 = Console, 1 = Network
    in property <int> console-count: 0;
    in property <int> network-count: 0;
    in property <[ConsoleRow]> console-rows;
    in property <[NetRow]> net-rows;

    // ------------------------------------------------------------------
    // intents surfaced to Rust
    // ------------------------------------------------------------------
    callback go-back();
    callback go-forward();
    callback reload();
    callback new-tab();
    callback navigate(url: string);
    callback activate-tab(idx: int);
    callback close-tab(idx: int);
    callback open-manager();
    callback close-manager();
    callback mgr-new-tab-in(idx: int);
    callback mgr-move-tab-to(idx: int);
    callback mgr-delete(idx: int);
    callback mgr-start-rename(idx: int);
    callback mgr-rename(idx: int);
    callback mgr-add();
    callback mgr-recolor(idx: int, palette: int);
    callback mgr-select(idx: int);
    // raw keyboard/pointer events from the page; Rust decides chords
    callback page-key(pressed: bool, text: string, ctrl: bool, shift: bool, alt: bool, meta: bool, repeat: bool);
    // kind: 0 move, 1 down, 2 up, 4 out — button: 0 left, 1 right, 2 middle
    callback page-pointer(x: length, y: length, kind: int, button: int);
    callback page-wheel(x: length, y: length, delta-x: length, delta-y: length);
    // context-menu intents (index into `menu-items`)
    callback menu-pick(idx: int);
    callback menu-close();
    // DevTools intents: pick a pane (0 console / 1 network) or close the panel.
    callback devtools-select-view(view: int);
    callback devtools-close();

    // Console severity: icon + colour (error red, warn yellow, info/log grey).
    function devtools-level-icon(level: string) -> string {
        if (level == "error") { return "\u{2715}"; }
        if (level == "warn") { return "⚠"; }
        if (level == "info") { return "i"; }
        return "\u{203A}";
    }

    function devtools-level-color(level: string) -> color {
        if (level == "error") { return #ef5350; }
        if (level == "warn") { return #e6c07b; }
        if (level == "info") { return #b8b8b8; }
        return #9a9a9a;
    }

    // fixed palette; index also addresses `palette-color` for add/rename
    function palette-color(idx: int) -> color {
        if (idx == 0) { return #4a90d9; }
        if (idx == 1) { return #e06666; }
        if (idx == 2) { return #6aa84f; }
        if (idx == 3) { return #f6b26b; }
        if (idx == 4) { return #8e7cc3; }
        if (idx == 5) { return #6d4c41; }
        if (idx == 6) { return #0097a7; }
        return #9e9e9e;
    }

    VerticalLayout {
        width: parent.width;
        height: parent.height;

        // ---- toolbar -----------------------------------------------------
        Rectangle {
            height: 38px;
            background: #2b2b2b;

            HorizontalLayout {
                x: 8px;
                height: parent.height;
                cross-axis-alignment: center;
                spacing: 6px;

                MiniButton { label: "←"; enabled: root.can-back; clicked => { root.go-back(); } }
                MiniButton { label: "→"; enabled: root.can-fwd; clicked => { root.go-forward(); } }
                MiniButton { label: "⟳"; clicked => { root.reload(); } }

                url-bar := UrlBar {
                    min-width: 160px;
                    horizontal-stretch: 1;
                    focus-token: root.focus-url-token;
                    submitted(txt) => { root.navigate(txt); }
                }

                MiniButton { label: "＋"; clicked => { root.new-tab(); } }

                // container dropdown: shows the active tab's container,
                // opens the manager on click
                Rectangle {
                    height: 24px;
                    width: Math.max(80px, cont-lbl.preferred-width + 34px);
                    bgr := Rectangle { background: cb.has-hover ? #3d3d3d : #262626; border-radius: 4px; }
                    cont-lbl := Text {
                        text: root.container-label;
                        color: #dddddd;
                        x: 8px;
                        vertical-alignment: center;
                        height: parent.height;
                    }
                    arrow := Text {
                        text: "▾";
                        color: #999999;
                        x: parent.width - 18px;
                        vertical-alignment: center;
                        height: parent.height;
                    }
                    cb := TouchArea { clicked => { root.open-manager(); } }
                }
            }
        }

        // ---- tab strip ----------------------------------------------------
        Rectangle {
            height: 30px;
            background: #252525;

            Flickable {
                width: parent.width;
                height: parent.height;
                horizontal-stretch: 1000;
                viewport-width: Math.max(self.width, tab-row.width + 16px);

                tab-row := HorizontalLayout {
                    width: self.preferred-width;
                    spacing: 4px;
                    padding-left: 6px;
                    padding-top: 3px;

                    for tab[idx] in tabs: Rectangle {
                        height: 24px;
                        width: Math.min(220px, Math.max(90px, tt.preferred-width + 44px));
                        tbgr := Rectangle {
                            background: tab.active ? #3a3a3a : #2e2e2e;
                            border-radius: 4px;
                        }
                        // container-colored stripe
                        stripe := Rectangle {
                            x: 6px;
                            width: 5px;
                            y: 4px;
                            height: parent.height - 8px;
                            border-radius: 2px;
                            background: tab.color;
                        }
                        tt := Text {
                            text: tab.title == "" ? "New Tab" : tab.title;
                            color: tab.active ? #f0f0f0 : #999999;
                            x: 16px;
                            vertical-alignment: center;
                            max-width: parent.width - 40px;
                            overflow: elide;
                        }
                        xbtn := Text {
                            text: "✕";
                            color: xt.has-hover ? #ffffff : #888888;
                            x: parent.width - 20px;
                            vertical-alignment: center;
                        }
                        // tabta declared before the ✕ ⇒ bottom z-order: the
                        // tab activates on click; ✕zone (declared last, top,
                        // sized to the glyph only — a bare TouchArea would
                        // fill the whole tab) closes it instead
                        tabta := TouchArea {
                            clicked => { root.activate-tab(idx); }
                        }
                        xzone := Rectangle {
                            x: parent.width - 24px;
                            width: 20px;
                            height: parent.height;
                            xt := TouchArea {
                                clicked => { root.close-tab(idx); }
                            }
                        }
                    }
                }
            }
        }

        // ---- page ----------------------------------------------------------
        page := PageSurface {
            horizontal-stretch: 1;
            vertical-stretch: 1;
            focus-token: root.focus-page-token;
            key(pressed, txt, ctrl, shift, alt, meta, repeat) => {
                root.page-key(pressed, txt, ctrl, shift, alt, meta, repeat);
            }

            Rectangle {
                x: 0; y: 0;
                width: parent.width; height: parent.height;
                background: #ffffff;

                Image {
                    source: root.page-image;
                    width: parent.width;
                    height: parent.height;
                    image-fit: fill;
                }

                ta := TouchArea {
                    // clicking the page returns keyboard focus to it
                    changed pressed => { if (ta.pressed) { root.focus-page-token += 1; } }
                    pointer-event(ev) => {
                        // kind: 0 move, 1 down, 2 up, 4 out (`let` is immutable:
                        // derive with ternaries; coords come from the TouchArea)
                        let kind = ev.kind == PointerEventKind.down ? 1 : ev.kind == PointerEventKind.up ? 2 : ev.kind == PointerEventKind.cancel ? 4 : 0;
                        let btn = ev.button == PointerEventButton.right ? 1 : ev.button == PointerEventButton.middle ? 2 : 0;
                        root.page-pointer(ta.mouse-x, ta.mouse-y, kind, btn);
                    }
                    // Slint hands over winit's wheel deltas untouched, and the
                    // tab's engine (blitz) consumes that very convention
                    // (positive delta = wheel UP / content moves down-right),
                    // so forward them verbatim — negating here inverted the wheel.
                    scroll-event(ev) => {
                        root.page-wheel(ta.mouse-x, ta.mouse-y, ev.delta-x, ev.delta-y);
                        return EventResult.accept;
                    }
                }

                // ---- DevTools panel -----------------------------------------
                // Bottom-docked over the page frame, and — exactly like the
                // context menu and the container manager — an in-window
                // overlay Rectangle, not a PopupWindow (the LinuxKMS backend
                // has no popups). Declared after the page's `ta` ⇒ on top of
                // it: the scrim swallows page clicks and wheel events while
                // the panel is open, and the ListView scrolls instead.
                Rectangle {
                    visible: root.devtools-open;
                    x: 0;
                    y: parent.height - self.height;
                    width: parent.width;
                    height: Math.min(240px, parent.height * 0.65);
                    background: #171717;
                    clip: true;
                    dt-scrim := TouchArea { }
                    // separator from the page above
                    Rectangle { x: 0; y: 0; width: parent.width; height: 1px; background: #4a4a4a; }

                    VerticalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        padding-bottom: 6px;
                        spacing: 4px;

                        // ---- header: pane buttons (with entry counts) + close
                        Rectangle {
                            height: 32px;
                            HorizontalLayout {
                                x: 0; width: parent.width; height: parent.height;
                                cross-axis-alignment: center;
                                spacing: 6px;
                                MiniButton {
                                    label: "Console" + (root.console-count > 0 ? " " + root.console-count : "");
                                    tint: root.devtools-view == 0 ? #3a3a3a : #262626;
                                    clicked => { root.devtools-select-view(0); }
                                }
                                MiniButton {
                                    label: "Network" + (root.network-count > 0 ? " " + root.network-count : "");
                                    tint: root.devtools-view == 1 ? #3a3a3a : #262626;
                                    clicked => { root.devtools-select-view(1); }
                                }
                                Rectangle { horizontal-stretch: 1; }
                                MiniButton { label: "✕"; clicked => { root.devtools-close(); } }
                            }
                        }

                        // ---- console view -------------------------------------
                        if root.devtools-view == 0: ListView {
                            vertical-stretch: 1;
                            for dtc[i] in root.console-rows: Rectangle {
                                height: 22px;
                                dtcbg := Rectangle { background: dtcta.has-hover ? #262626 : Math.mod(i, 2) == 0 ? transparent : #1b1b1b; }
                                Text {
                                    x: 8px;
                                    width: 18px;
                                    height: parent.height;
                                    text: root.devtools-level-icon(dtc.level);
                                    color: root.devtools-level-color(dtc.level);
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                Text {
                                    x: 30px;
                                    max-width: Math.max(0px, parent.width - 38px);
                                    height: parent.height;
                                    text: dtc.text;
                                    color: root.devtools-level-color(dtc.level);
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                dtcta := TouchArea { }
                            }
                        }

                        // ---- network view --------------------------------------
                        if root.devtools-view == 1: VerticalLayout {
                            vertical-stretch: 1;
                            spacing: 2px;
                            // column captions
                            Rectangle {
                                height: 20px;
                                head := NetRowCells {
                                    width: parent.width;
                                    height: parent.height;
                                    cell-color: #8a8a8a;
                                    method: "Method";
                                    url: "URL";
                                    status: "Status";
                                    bytes: "Size";
                                    time: "Time";
                                }
                            }
                            ListView {
                                vertical-stretch: 1;
                                for dtn[i] in root.net-rows: Rectangle {
                                    height: 22px;
                                    net-row-bg := Rectangle { background: netrowta.has-hover ? #262626 : Math.mod(i, 2) == 0 ? transparent : #1b1b1b; }
                                    NetRowCells {
                                        x: 0; y: 0;
                                        width: parent.width;
                                        height: parent.height;
                                        method: dtn.method;
                                        url: dtn.url;
                                        status: dtn.status;
                                        bytes: dtn.size;
                                        time: dtn.time;
                                        cell-color: dtn.failed ? #ef5350 : #cfcfcf;
                                        status-color: dtn.failed ? #ef5350 : #cfcfcf;
                                    }
                                    netrowta := TouchArea { }
                                }
                            }
                        }
                    }
                }

                // ---- context menu -----------------------------------------
                // An in-page overlay, not a PopupWindow: the LinuxKMS backend
                // has no popups, so — exactly like the container manager —
                // the menu is drawn on top of the page frame. Declared after
                // `ta` ⇒ on top of it: the scrim swallows page clicks while
                // the menu is open, and every item row (declared later than
                // the scrim) keeps its own click.
                Rectangle {
                    visible: root.menu-open;
                    x: 0; y: 0;
                    width: parent.width; height: parent.height;
                    menu-scrim := TouchArea {
                        clicked => { root.menu-close(); }
                    }
                    Rectangle {
                        x: Math.max(2px, Math.min(root.menu-x, parent.width - self.width - 2px));
                        y: Math.max(2px, Math.min(root.menu-y, parent.height - self.height - 2px));
                        width: 232px;
                        height: menu-list.preferred-height + 10px;
                        background: #2a2a2a;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: #4a4a4a;
                        menu-list := VerticalLayout {
                            padding: 4px;
                            spacing: 1px;
                            for mi[i] in root.menu-items: Rectangle {
                                height: 26px;
                                mibgr := Rectangle {
                                    background: mita.has-hover ? #3d3d3d : transparent;
                                    border-radius: 4px;
                                }
                                mitxt := Text {
                                    text: mi.label;
                                    color: #e8e8e8;
                                    x: 10px;
                                    vertical-alignment: center;
                                    max-width: parent.width - 18px;
                                    overflow: elide;
                                }
                                mita := TouchArea {
                                    clicked => { root.menu-pick(i); }
                                }
                            }
                        }
                    }
                }
            }
        }

        // ---- status bar ------------------------------------------------------
        Rectangle {
            height: 24px;
            background: #2b2b2b;

            HorizontalLayout {
                x: 10px;
                height: parent.height;
                cross-axis-alignment: center;
                spacing: 8px;

                Text { text: root.spinner; color: #bbbbbb; }
                Text { text: root.sec-glyph; color: root.sec-color; }
                st := Text {
                    text: root.status-text;
                    color: #aaaaaa;
                    vertical-alignment: center;
                    max-width: Math.max(0px, root.width - 220px);
                    overflow: elide;
                }
            }
        }
    }

    // ------------------------------------------------------------------------
    // container manager overlay
    // ------------------------------------------------------------------------
    Rectangle {
        x: 0; y: 0;
        width: root.width; height: root.height;
        visible: root.manager-open;
        background: #00000099;
        scrim := TouchArea { clicked => { root.close-manager(); } }

        panel := Rectangle {
            TouchArea {} // swallow clicks over the panel
            x: root.width - self.width;
            width: Math.min(380px, root.width);
            height: root.height;
            background: #1e1e1e;

            VerticalLayout {
                padding: 12px;
                spacing: 6px;

                HorizontalLayout {
                    spacing: 8px;
                    height: 26px;
                    Text { text: "Containers"; color: #f0f0f0; font-weight: 600; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    MiniButton { label: "✕"; clicked => { root.close-manager(); } }
                }

                for c[i] in containers: Rectangle {
                    height: 54px;
                    width: parent.width;
                    sel := Rectangle { background: i == root.selected-container ? #383838 : #262626; border-radius: 4px; }
                    // declared before the content ⇒ bottom z-order: clicking
                    // anywhere on the row still selects it, but the New/Move
                    // tab/Delete/Ren buttons (declared on top) keep receiving
                    // their clicks — a TouchArea declared last swallowed all
                    // of them, which is why "New" only ever re-selected.
                    selta := TouchArea { clicked => { root.mgr-select(i); } }
                    VerticalLayout {
                        x: 6px; y: 3px;
                        width: parent.width - 12px;
                        spacing: 2px;
                        HorizontalLayout {
                            height: 22px;
                            spacing: 6px;
                            Rectangle { width: 12px; height: 12px; border-radius: 3px; background: c.color; }
                            if i == root.editing-index: LineEdit {
                                horizontal-stretch: 1;
                                text: root.container-edit-text;
                                edited(t) => { root.container-edit-text = t; }
                                accepted => { root.mgr-rename(i); }
                            }
                            Text {
                                visible: i != root.editing-index;
                                text: c.name + (c.isDefault ? " ★" : "");
                                color: #e8e8e8;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            MiniButton { visible: i != root.editing-index; label: "Ren"; clicked => { root.mgr-start-rename(i); } }
                            MiniButton { visible: i == root.editing-index; label: "OK"; clicked => { root.mgr-rename(i); } }
                        }
                        HorizontalLayout {
                            height: 22px;
                            spacing: 6px;
                            MiniButton { label: "New"; clicked => { root.mgr-new-tab-in(i); } }
                            MiniButton { label: "Move tab"; clicked => { root.mgr-move-tab-to(i); } }
                            MiniButton {
                                label: "Delete";
                                enabled: !c.isDefault;
                                clicked => { root.mgr-delete(i); }
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }
                    }
                }

                Text { text: "Add container"; color: #f0f0f0; }
                HorizontalLayout {
                    height: 26px;
                    spacing: 6px;
                    LineEdit {
                        horizontal-stretch: 1;
                        text: root.container-edit-text;
                        edited(t) => { root.container-edit-text = t; }
                        placeholder-text: "name";
                        accepted => { root.mgr-add(); }
                    }
                    MiniButton { label: "Add"; clicked => { root.mgr-add(); } }
                }
                HorizontalLayout {
                    height: 20px;
                    spacing: 6px;
                    for p in [0, 1, 2, 3, 4, 5, 6]: Rectangle {
                        width: 18px; height: 18px; border-radius: 4px;
                        background: root.palette-color(p);
                        pt := TouchArea { clicked => { root.mgr-recolor(root.selected-container, p); } }
                    }
                }

                Rectangle { vertical-stretch: 1; }
                Text {
                    text: "Move tab re-spawns the active tab in the selected container (keeping its URL). Delete wipes that container's data. The palette recolors the selected container.";
                    color: #888888;
                    wrap: word-wrap;
                }
            }
        }
    }
}
