// IronSurf shell UI — single component, all state driven from Rust.
//
// The Rust side (src/app.rs) owns the real state (tabs, containers, IPC);
// this file renders snapshots pushed through `in` properties and forwards
// user intents through `out` callbacks. Keyboard chords are decided in
// Rust (see `keymap::shortcut_for`), so this file stays dumb.
//
// Note: Slint ids are only visible to descendants, and built-in elements
// cannot declare custom properties — so the two focus() watchers live in
// the small custom components `UrlBar` and `PageSurface` instead.

import { LineEdit, ListView, CheckBox } from "std-widgets.slint";

export struct TabInfo {
    id: int,
    title: string,
    color: color,
    active: bool,
    /// Digit of the Alt-chord that reaches this tab today ("1" … "9"; empty
    /// when no chord does). Rust recomputes it from the live tab order, so the
    /// badge always shows where Alt-1 … Alt-9 land right now.
    shortcut: string,
}

export struct ContainerInfo {
    name: string,
    color: color,
    isDefault: bool,
}

/// One context-menu row (labels only; Rust keeps the matching actions and
/// maps the picked index back onto them).
export struct MenuItem {
    label: string,
}

/// One DevTools console row, already reduced by `state::TabState::console_rows`
/// (`level` drives the icon/colour, `text` is `"[source] message"`).
export struct ConsoleRow {
    level: string,
    text: string,
}

/// One DevTools network row: pre-formatted columns (`—` for values the engine
/// never sent); `failed` paints the status cell red with the error text in it.
/// `initiator` is what triggered the request (document / script / resource /
/// xhr / fetch).
export struct NetRow {
    method: string,
    url: string,
    initiator: string,
    status: string,
    size: string,
    time: string,
    failed: bool,
}

/// One syntax-highlighted token of the DevTools Inspector tree: `kind` is a
/// `state::TOK_*` value and `inspect-kind-color` below is the colour table —
/// a row is a list of these, never a pre-formatted string.
export struct Tok {
    text: string,
    kind: int,
}

/// One Inspector tree row. `node` is the snapshot's node id (a click reports it
/// back for `ToTab::InspectSelect`), `depth × 12px` is the indent, `twisty` is
/// `+` / `−` (`""` on a leaf, which is therefore not clickable), `toks` the
/// markup, `selected` the highlight and `italic` comments and the doctype.
export struct InspectRow {
    node: int,
    depth: int,
    twisty: string,
    toks: [Tok],
    selected: bool,
    italic: bool,
}

/// One breadcrumb crumb: the node id plus its name split the way the tree
/// splits it (`div` + `#main`), so `div#main` is not one flat label.
export struct CrumbItem {
    node: int,
    tag: string,
    ident: string,
}

/// One userscript-menu row, reduced from a stored `Userscript` by
/// `userscripts::userscript_rows` (`patterns` is the URL-pattern list joined
/// by `", "`, painted dim under the name; `enabled` drives the CheckBox).
export struct UserscriptRow {
    id: int,
    name: string,
    patterns: string,
    enabled: bool,
}

/// One User-Agent-menu row, reduced from the active tab's container value by
/// `user_agents::ua_menu_rows` (`ua` is the wire string — empty on the
/// "Default (IronSurf)" row; `active` marks the row matching the container).
export struct UaRow {
    label: string,
    ua: string,
    active: bool,
}

/// A tiny borderless toolbar button (cheaper than styled Buttons in rows).
component MiniButton inherits Rectangle {
    in property <string> label: "";
    in property <bool> enabled: true;
    in property <color> tint: #262626;
    callback clicked();
    width: Math.max(22px, lbl.preferred-width + 12px);
    height: 24px;
    bg := Rectangle {
        background: ta.has-hover ? (root.enabled ? #3d3d3d : #2c2c2c) : root.tint;
        border-radius: 4px;
    }
    lbl := Text {
        text: root.label;
        color: root.enabled ? #e8e8e8 : #6a6a6a;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: parent.width;
        height: parent.height;
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

/// URL bar wrapper: bumps `focus-token` (from Rust / Ctrl-L / F6) to grab
/// focus and highlight the whole address, so typing replaces it outright.
component UrlBar inherits Rectangle {
    in property <int> focus-token: 0;
    in-out property<string> text <=> edit.text;
    callback submitted(text: string);
    edit := LineEdit {
        width: parent.width;
        height: parent.height;
        placeholder-text: "Search or enter address — Ctrl-L or F6 to focus";
        accepted(txt) => { root.submitted(txt); }
    }
    // armed on token bumps only (> 0), so clicking out of the bar does not
    // yank focus back
    changed focus-token => {
        if (root.focus-token > 0) {
            edit.focus();
            edit.select-all();
        }
    }
}

/// Find-in-page bar (Ctrl-`F`): a strip that floats over the top-right of the
/// page — the text entry, the live counter the tab reports (`3 / 12`, `No
/// results`), ▲/▼ to walk the results, and ✕ to close it. Enter jumps forward,
/// Shift-Enter and the arrow keys backward; every edit re-searches at once.
/// The highlights themselves are painted by the tab (its document, its pixels):
/// yellow behind every match, light blue behind the one this bar sits on.
component FindBar inherits Rectangle {
    /// Bumped by Rust (Ctrl-`F`) to pull focus into the entry.
    in property <int> focus-token: 0;
    /// The tab's counter, verbatim (see `FindState::label` in src/state.rs).
    in property <string> count: "";
    /// The query in the entry (two-way with the shell).
    in-out property <string> text: "";
    callback query-changed(text: string);
    callback next();
    callback previous();
    callback close();

    width: 372px;
    height: 40px;

    // The panel: opaque, so the page under it stays legible as a background.
    Rectangle {
        width: parent.width;
        height: parent.height - 8px;
        background: #242424;
        border-radius: 6px;
        border-width: 1px;
        border-color: #5a5a5a;
        // Nothing behind the panel may take the click (the page's TouchArea
        // covers the same pixels and would otherwise swallow the bar's own).
        find-scrim := TouchArea { }

        HorizontalLayout {
            x: 0; width: parent.width; height: parent.height;
            padding-left: 8px; padding-right: 8px;
            spacing: 6px;
            alignment: center;

            find-input := LineEdit {
                placeholder-text: "Find in page";
                text <=> root.text;
                // Enter → next, Shift-Enter / ↑ → previous, ↓ → next, Esc →
                // close. Intercepted here rather than via `accepted` so the
                // shifted chord reaches Rust too instead of beeping, and
                // `edited` (below) carries the typing itself.
                edited(txt) => { root.query-changed(txt); }
                key-pressed(ev) => {
                    if (ev.text == Key.Escape) {
                        root.close();
                        return EventResult.accept;
                    }
                    if (ev.text == Key.Return) {
                        if (ev.modifiers.shift) { root.previous(); } else { root.next(); }
                        return EventResult.accept;
                    }
                    if (ev.text == Key.UpArrow) {
                        root.previous();
                        return EventResult.accept;
                    }
                    if (ev.text == Key.DownArrow) {
                        root.next();
                        return EventResult.accept;
                    }
                    return EventResult.reject;
                }
            }

            Text {
                text: root.count;
                color: root.count == "No results" ? #e06666 : #a8b8c8;
                font-size: 12px;
                vertical-alignment: center;
            }
            MiniButton { label: "▲"; clicked => { root.previous(); } }
            MiniButton { label: "▼"; clicked => { root.next(); } }
            MiniButton { label: "✕"; clicked => { root.close(); } }
        }
    }

    // Armed on token bumps only (> 0), like the URL bar: clicking away into the
    // page must not yank the caret back into the entry.
    changed focus-token => {
        if (root.focus-token > 0) { find-input.focus(); }
    }
}

/// The page's keyboard focus holder. Every key press is forwarded to Rust
/// (consumed so Slint never beeps); Rust either acts on a browser chord or
/// relays a ToTab::Key to the active tab process.
component PageSurface inherits FocusScope {
    in property <int> focus-token: 0;
    callback key(pressed: bool, text: string, ctrl: bool, shift: bool, alt: bool, meta: bool, repeat: bool);
    changed focus-token => {
        if (root.focus-token > 0) { self.focus(); }
    }
    key-pressed(ev) => {
        root.key(true, ev.text, ev.modifiers.control, ev.modifiers.shift, ev.modifiers.alt, ev.modifiers.meta, ev.repeat);
        return EventResult.accept;
    }
    key-released(ev) => {
        root.key(false, ev.text, ev.modifiers.control, ev.modifiers.shift, ev.modifiers.alt, ev.modifiers.meta, ev.repeat);
        return EventResult.accept;
    }
}

/// One row (or the caption row) of the DevTools network table: Method | URL |
/// Initiator | Status | Size | Time, laid out with explicit geometry so
/// captions and data line up, and the URL is the column that absorbs the
/// window's width.
component NetRowCells inherits Rectangle {
    in property <string> method: "";
    in property <string> url: "";
    in property <string> initiator: "";
    in property <string> status: "";
    in property <string> bytes: "";
    in property <string> time: "";
    in property <color> cell-color: #cfcfcf;
    in property <color> status-color: root.cell-color;

    m := Text {
        x: 8px; width: 56px; height: parent.height;
        text: root.method; color: root.cell-color;
        vertical-alignment: center; overflow: elide;
    }
    u := Text {
        x: 70px; width: Math.max(60px, parent.width - 382px); height: parent.height;
        text: root.url; color: root.cell-color;
        vertical-alignment: center; overflow: elide;
    }
    i := Text {
        x: parent.width - 312px; width: 80px; height: parent.height;
        text: root.initiator; color: root.cell-color;
        vertical-alignment: center; overflow: elide;
    }
    s := Text {
        x: parent.width - 232px; width: 100px; height: parent.height;
        text: root.status; color: root.status-color;
        vertical-alignment: center; overflow: elide;
    }
    sz := Text {
        x: parent.width - 132px; width: 66px; height: parent.height;
        text: root.bytes; color: root.cell-color;
        vertical-alignment: center; overflow: elide;
    }
    t := Text {
        x: parent.width - 62px; width: 54px; height: parent.height;
        text: root.time; color: root.cell-color;
        vertical-alignment: center; overflow: elide;
    }
}

export component AppWindow inherits Window {
    title: "IronSurf";
    background: #1f1f1f;
    min-width: 640px;
    min-height: 480px;

    // ------------------------------------------------------------------
    // state pushed from Rust
    // ------------------------------------------------------------------
    in property <[TabInfo]> tabs;
    in property <[ContainerInfo]> containers;
    in property <image> page-image;
    // two-way alias: Rust pushes URLs here and they propagate to the URL bar
    in-out property<string> url-text <=> url-bar.text;
    in property <string> status-text;
    in property <string> sec-glyph: "";
    in property <color> sec-color: #888888;
    in property <string> spinner: " ";
    /// Whether the **active** tab is loading (a copy of its `loading` state,
    /// pushed by Rust with every `LoadingChanged` / UI sync). Drives the
    /// indeterminate progress bar at the left end of the status bar: the bar
    /// only exists while this is true, and each transition re-triggers its
    /// sweep animation from the left edge.
    in property <bool> loading: false;
    /// Sweep position of the loading bar: 0 … 12, where 0 sits the lit
    /// segment at the track's left end and 12 at its right end (4 px a step,
    /// 96 px wide track). Rust advances it from the spinner timer — one step
    /// per 120 ms while a load is in flight, ping-ponging — and zeroes it the
    /// instant a load starts, so every navigation begins the sweep afresh.
    in property <int> load-progress: 0;
    in property <string> container-label: "";
    in property <bool> can-back: false;
    in property <bool> can-fwd: false;
    in property <bool> manager-open: false;
    in property <int> editing-index: -1;
    in-out property <string> container-edit-text;
    in property <int> selected-container: 0;
    in property <int> active-index: 0;
    // bumped by Rust to move focus programmatically (Ctrl-L / Esc / startup,
    // and every newly opened tab)
    in property <int> focus-url-token: 0;
    // find-in-page bar (Ctrl-F): `find-open` is per active tab (the tab record
    // owns the flag, like DevTools), `find-count` is the tab's own reported
    // counter, `find-text` the query in the entry (two-way: Rust pushes a
    // surviving query when the bar reopens), and `find-focus-token` is bumped
    // to pull the caret into the entry.
    in property <bool> find-open: false;
    in property <string> find-count: "";
    in-out property <string> find-text: "";
    in property <int> find-focus-token: 0;
    callback find-query-changed(text: string);
    callback find-next();
    callback find-previous();
    callback find-close();
    in-out property <int> focus-page-token: 0;
    // page area size, read by Rust to send ToTab::Resize
    out property <length> page-width: page.width;
    out property <length> page-height: page.height;
    // hover cursor (task: cursor icon): the shape a tab wants over its page
    // (`FromTab::CursorChanged`), pushed by Rust onto the page TouchArea.
    in property <MouseCursor> page-cursor;
    // whether the pointer is over the page, and its last position in WINDOW
    // coordinates: when a new shape arrives Rust re-dispatches a pointer
    // move there — Slint only re-reads a TouchArea's `mouse-cursor` while
    // processing a pointer event, and the mouse may have stopped the instant
    // the tab answered.
    out property <bool> page-pointer-inside: ta.has-hover;
    out property <length> pointer-x-in-window: page-frame.absolute-position.x + ta.mouse-x;
    out property <length> pointer-y-in-window: page-frame.absolute-position.y + ta.mouse-y;
    // right-click context menu (task: context menu): opened by Rust when a
    // tab reports `FromTab::ContextMenu`; (menu-x, menu-y) is in page-area
    // coordinates, items are labels only — Rust maps the picked index onto
    // the real action.
    in property <bool> menu-open: false;
    in property <length> menu-x: 0px;
    in property <length> menu-y: 0px;
    in property <[MenuItem]> menu-items;
    // JS dialog (task: window.alert/confirm/prompt): opened by Rust when a
    // tab reports `FromTab::DialogRequest`; the requesting tab is activated
    // first, so the modal always belongs to the page on screen. Rust keeps
    // the (tab, dialog id) pair and answers over the wire when the user
    // presses a button. kind: 0 alert, 1 confirm, 2 prompt.
    in property <bool> dialog-open: false;
    in property <int> dialog-kind: 0;
    in property <string> dialog-message: "";
    in property <string> dialog-title: "";
    in-out property <string> dialog-input: "";

    // DevTools panel (task: DevTools UI): bottom-docked over the page area of
    // the *active* tab. Rust owns the open/closed flag (per tab) and the view
    // choice, and pushes the reduced console/network rows on every drain tick
    // while the panel is open.
    in property <bool> devtools-open: false;
    in property <int> devtools-view: 0; // 0 = Console, 1 = Network
    in property <int> console-count: 0;
    in property <int> network-count: 0;
    in property <[ConsoleRow]> console-rows;
    in property <[NetRow]> net-rows;
    // DevTools **Inspector** pane (third pane, `devtools-view == 2`). The tab
    // owns the document and sends a flat `InspectSnapshot`; Rust folds it,
    // selects, builds the breadcrumb and re-renders the markup as tokens, then
    // pushes the result here: `inspector-count` is the element count on the
    // header button (dim while `inspector-truncated`), `inspector-pick` says
    // ⌖ is armed for this tab, `inspector-summary` names the document, the
    // breadcrumb is clickable, and `inspector-empty`/`inspector-hint` is the
    // honest empty state (never a blank rectangle).
    in property <int> inspector-count: 0;
    in property <bool> inspector-truncated: false;
    in property <bool> inspector-pick: false;
    in property <string> inspector-summary: "";
    in property <bool> inspector-empty: false;
    in property <string> inspector-hint: "";
    in property <[InspectRow]> inspector-rows;
    in property <[CrumbItem]> inspector-crumb;

    // Userscript menu (task: userscript menu): toggled by the "</>" toolbar
    // button. Rust owns the open flag, re-pushes `us-scripts` from the Store
    // after every mutation, and keeps `(us-editing, us-name, us-patterns,
    // us-code)` as the inline editor — opened by "+ New script" **or** by
    // clicking a row (`us-edit(idx)` prefills that script; `us-editing-existing`
    // tells the heading which mode is up). A failed Save leaves the
    // editor up with `us-error` set and the script NOT added.
    in property <bool> us-menu-open: false;
    in property <[UserscriptRow]> us-scripts;
    in property <bool> us-editing: false;
    // true while the editor holds a *pre-filled existing* script (upsert,
    // same id), false for a fresh "+ New script" draft.
    in property <bool> us-editing-existing: false;
    in property <string> us-error: "";
    in-out property <string> us-name: "";
    in-out property <string> us-patterns: "";
    in-out property <string> us-code: "";

    // User-Agent switcher (task: per-container UA): toggled by the "UA"
    // toolbar button and scoped to the *active tab's container*. Rust owns
    // the open flag, re-pushes `ua-rows`/`ua-current` from the Store after
    // every mutation and after every tab switch, and shows a rejected custom
    // string as the one-line `ua-error` (the draft in the LineEdit survives).
    in property <bool> ua-menu-open: false;
    in property <[UaRow]> ua-rows;
    in property <string> ua-current: "";
    in property <string> ua-error: "";
    // the custom-UA LineEdit (mirrored so the Apply button, a sibling, can
    // hand its text back — ids are only visible to descendants — and so a
    // rejected Apply keeps the draft while `ua-error` says why)
    in-out property <string> ua-custom: "";

    // Archive mode (the 💾 toggle): Rust owns every value — `archive-enabled`
    // mirrors the live setting (off by default, persisted), `archive-dir-text`
    // is the root folder (prefilled with the effective one, the built-in
    // default being $HOME/Downloads/ironsurf-tabs), `archive-status` is the
    // one-line summary under the CheckBox, and `archive-error` the one-line
    // rejection of a bad folder (the draft survives, UA-menu style).
    in property <bool> archive-menu-open: false;
    in-out property <bool> archive-enabled: false;
    in-out property <string> archive-dir-text: "";
    in property <string> archive-status: "";
    in property <string> archive-error: "";

    // ------------------------------------------------------------------
    // intents surfaced to Rust
    // ------------------------------------------------------------------
    callback go-back();
    callback go-forward();
    callback reload();
    callback new-tab();
    callback navigate(url: string);
    callback activate-tab(idx: int);
    callback close-tab(idx: int);
    callback open-manager();
    callback close-manager();
    callback mgr-new-tab-in(idx: int);
    callback mgr-move-tab-to(idx: int);
    callback mgr-delete(idx: int);
    callback mgr-start-rename(idx: int);
    callback mgr-rename(idx: int);
    callback mgr-add();
    callback mgr-recolor(idx: int, palette: int);
    callback mgr-select(idx: int);
    // raw keyboard/pointer events from the page; Rust decides chords
    callback page-key(pressed: bool, text: string, ctrl: bool, shift: bool, alt: bool, meta: bool, repeat: bool);
    // kind: 0 move, 1 down, 2 up, 4 out — button: 0 left, 1 right, 2 middle
    callback page-pointer(x: length, y: length, kind: int, button: int);
    callback page-wheel(x: length, y: length, delta-x: length, delta-y: length);
    // context-menu intents (index into `menu-items`)
    callback menu-pick(idx: int);
    callback menu-close();
    // DevTools intents: pick a pane (0 console / 1 network) or close the panel.
    callback devtools-select-view(view: int);
    callback devtools-close();
    // `Clear` on the visible pane's feed (Console / Network), ⌖ *inspect
    // element* toggle, and the two Inspector intents: a tree row clicked
    // (`ToTab::InspectSelect`, the tab paints its box) and a `+/−` twisty
    // (folding is the shell's own business — nothing goes over the wire).
    callback devtools-clear();
    callback devtools-toggle-pick();
    callback devtools-select-node(node: int);
    callback devtools-toggle-fold(node: int);
    // JS-dialog intents: `OK` (accepted, `dialog-input` carries the prompt
    // text) or `Cancel`/Esc (dismissed). The scrim deliberately does nothing
    // — a modal is dismissed by an answer, never by clicking past it.
    callback dialog-accept();
    callback dialog-cancel();

    // Userscript-menu intents (indices are rows of `us-scripts`; Rust maps
    // them back onto script ids). Toggle/delete/save persist through the
    // Store at once and rebroadcast the enabled set to every live tab.
    callback toggle-us-menu();
    callback close-us-menu();
    callback us-toggle(idx: int);
    callback us-delete(idx: int);
    // row clicked (anywhere but the CheckBox / ✕): edit that script.
    callback us-edit(idx: int);
    callback us-new();
    callback us-save();
    callback us-cancel();

    // User-Agent-menu intents (indices are rows of `ua-rows`; Rust maps them
    // back onto preset strings). Every accepted choice persists through the
    // Store at once and rebroadcasts ToTab::SetUserAgent to the live tabs of
    // the *container the menu belongs to* only.
    callback toggle-ua-menu();
    callback close-ua-menu();
    callback ua-select(idx: int);
    callback ua-copy();
    callback ua-restore-default();
    // the custom-UA LineEdit → Apply (its current text, blank = default).
    callback ua-apply-custom(text: string);

    // Archive-menu intents: the CheckBox flips the mode (broadcast to every
    // live tab at once, global — not per-container), the LineEdit → Apply
    // re-points the root folder (validated in Rust; rejected → `archive-error`).
    callback toggle-archive-menu();
    callback close-archive-menu();
    callback archive-set-enabled(on: bool);
    callback archive-apply-dir(text: string);

    // Console severity: icon + colour (error red, warn yellow, info/log grey).
    function devtools-level-icon(level: string) -> string {
        if (level == "error") { return "\u{2715}"; }
        if (level == "warn") { return "⚠"; }
        if (level == "info") { return "i"; }
        return "\u{203A}";
    }

    function devtools-level-color(level: string) -> color {
        if (level == "error") { return #ef5350; }
        if (level == "warn") { return #e6c07b; }
        if (level == "info") { return #b8b8b8; }
        return #9a9a9a;
    }

    // The Inspector's fixed colour table (see `state::TOK_*`): punctuation
    // grey, tag name orange, attribute name blue, attribute value green, text
    // near-white, comment/doctype grey (italic comes from the row), `id`/`class`
    // values and dangerous ones (`<script>`/`<style>`/`<head>`, `data:` URLs)
    // their own colours.
    function inspect-kind-color(kind: int) -> color {
        if (kind == 0) { return #e6e6e6; } // text
        if (kind == 1) { return #e8a33d; } // tag name
        if (kind == 2) { return #6aa6ff; } // attribute name
        if (kind == 3) { return #7ec96f; } // attribute value
        if (kind == 4) { return #8a8a8a; } // punctuation
        if (kind == 5) { return #ef5350; } // danger
        if (kind == 6) { return #8a8a8a; } // comment
        if (kind == 7) { return #8a8a8a; } // doctype
        if (kind == 8) { return #c586c0; } // id / class value
        return #cfcfcf;
    }

    // fixed palette; index also addresses `palette-color` for add/rename
    function palette-color(idx: int) -> color {
        if (idx == 0) { return #4a90d9; }
        if (idx == 1) { return #e06666; }
        if (idx == 2) { return #6aa84f; }
        if (idx == 3) { return #f6b26b; }
        if (idx == 4) { return #8e7cc3; }
        if (idx == 5) { return #6d4c41; }
        if (idx == 6) { return #0097a7; }
        return #9e9e9e;
    }

    VerticalLayout {
        width: parent.width;
        height: parent.height;

        // ---- toolbar -----------------------------------------------------
        Rectangle {
            height: 38px;
            background: #2b2b2b;

            HorizontalLayout {
                x: 8px;
                height: parent.height;
                cross-axis-alignment: center;
                spacing: 6px;

                MiniButton { label: "←"; enabled: root.can-back; clicked => { root.go-back(); } }
                MiniButton { label: "→"; enabled: root.can-fwd; clicked => { root.go-forward(); } }
                MiniButton { label: "⟳"; clicked => { root.reload(); } }

                url-bar := UrlBar {
                    min-width: 160px;
                    horizontal-stretch: 1;
                    focus-token: root.focus-url-token;
                    submitted(txt) => { root.navigate(txt); }
                }

                MiniButton { label: "＋"; clicked => { root.new-tab(); } }

                // userscript menu (task: userscript menu)
                MiniButton { label: "</>"; clicked => { root.toggle-us-menu(); } }

                // User-Agent switcher (task: per-container UA) — same house
                // pattern as the "</>" button directly to its left.
                MiniButton { label: "UA"; clicked => { root.toggle-ua-menu(); } }

                // archive mode (task: archive mode) — same house pattern
                // again; the glyph doubles as the on/off state hint in the
                // overlay, the button only ever toggles the menu.
                MiniButton { label: "\u{1F4BE}"; clicked => { root.toggle-archive-menu(); } }

                // container dropdown: shows the active tab's container,
                // opens the manager on click
                Rectangle {
                    height: 24px;
                    width: Math.max(80px, cont-lbl.preferred-width + 34px);
                    bgr := Rectangle { background: cb.has-hover ? #3d3d3d : #262626; border-radius: 4px; }
                    cont-lbl := Text {
                        text: root.container-label;
                        color: #dddddd;
                        x: 8px;
                        vertical-alignment: center;
                        height: parent.height;
                    }
                    arrow := Text {
                        text: "▾";
                        color: #999999;
                        x: parent.width - 18px;
                        vertical-alignment: center;
                        height: parent.height;
                    }
                    cb := TouchArea { clicked => { root.open-manager(); } }
                }
            }
        }

        // ---- tab strip ----------------------------------------------------
        Rectangle {
            height: 30px;
            background: #252525;

            Flickable {
                width: parent.width;
                height: parent.height;
                horizontal-stretch: 1000;
                viewport-width: Math.max(self.width, tab-row.width + 16px);

                tab-row := HorizontalLayout {
                    width: self.preferred-width;
                    spacing: 4px;
                    padding-left: 6px;
                    padding-top: 3px;

                    for tab[idx] in tabs: Rectangle {
                        height: 24px;
                        width: Math.min(220px, Math.max(90px, tt.preferred-width + (tab.shortcut == "" ? 44px : 61px)));
                        tbgr := Rectangle {
                            background: tab.active ? #3a3a3a : #2e2e2e;
                            border-radius: 4px;
                        }
                        // container-colored stripe
                        stripe := Rectangle {
                            x: 6px;
                            width: 5px;
                            y: 4px;
                            height: parent.height - 8px;
                            border-radius: 2px;
                            background: tab.color;
                        }
                        // Alt-digit badge: which Alt-N lands here today. It is
                        // re-rendered from the tab order on every snapshot, so
                        // opening/closing tabs moves the numbers by itself.
                        alt := Text {
                            text: tab.shortcut;
                            color: tab.active ? #c8c8c8 : #7a7a7a;
                            x: 15px;
                            width: 14px;
                            vertical-alignment: center;
                            horizontal-alignment: right;
                        }
                        tt := Text {
                            text: tab.title == "" ? "New Tab" : tab.title;
                            color: tab.active ? #f0f0f0 : #999999;
                            x: tab.shortcut == "" ? 16px : 33px;
                            vertical-alignment: center;
                            max-width: parent.width - (tab.shortcut == "" ? 40px : 57px);
                            overflow: elide;
                        }
                        xbtn := Text {
                            text: "✕";
                            color: xt.has-hover ? #ffffff : #888888;
                            x: parent.width - 20px;
                            vertical-alignment: center;
                        }
                        // tabta declared before the ✕ ⇒ bottom z-order: the
                        // tab activates on click; ✕zone (declared last, top,
                        // sized to the glyph only — a bare TouchArea would
                        // fill the whole tab) closes it instead
                        tabta := TouchArea {
                            clicked => { root.activate-tab(idx); }
                        }
                        xzone := Rectangle {
                            x: parent.width - 24px;
                            width: 20px;
                            height: parent.height;
                            xt := TouchArea {
                                clicked => { root.close-tab(idx); }
                            }
                        }
                    }
                }
            }
        }

        // ---- page ----------------------------------------------------------
        page := PageSurface {
            horizontal-stretch: 1;
            vertical-stretch: 1;
            focus-token: root.focus-page-token;
            key(pressed, txt, ctrl, shift, alt, meta, repeat) => {
                root.page-key(pressed, txt, ctrl, shift, alt, meta, repeat);
            }

            page-frame := Rectangle {
                x: 0; y: 0;
                width: parent.width; height: parent.height;
                background: #ffffff;

                Image {
                    source: root.page-image;
                    width: parent.width;
                    height: parent.height;
                    image-fit: fill;
                }

                ta := TouchArea {
                    // the page's pointer shape (task: cursor icon)
                    mouse-cursor: root.page-cursor;
                    // clicking the page returns keyboard focus to it
                    changed pressed => { if (ta.pressed) { root.focus-page-token += 1; } }
                    pointer-event(ev) => {
                        // kind: 0 move, 1 down, 2 up, 4 out (`let` is immutable:
                        // derive with ternaries; coords come from the TouchArea)
                        let kind = ev.kind == PointerEventKind.down ? 1 : ev.kind == PointerEventKind.up ? 2 : ev.kind == PointerEventKind.cancel ? 4 : 0;
                        let btn = ev.button == PointerEventButton.right ? 1 : ev.button == PointerEventButton.middle ? 2 : 0;
                        root.page-pointer(ta.mouse-x, ta.mouse-y, kind, btn);
                    }
                    // Slint hands over winit's wheel deltas untouched, and the
                    // tab's engine (blitz) consumes that very convention
                    // (positive delta = wheel UP / content moves down-right),
                    // so forward them verbatim — negating here inverted the wheel.
                    scroll-event(ev) => {
                        root.page-wheel(ta.mouse-x, ta.mouse-y, ev.delta-x, ev.delta-y);
                        return EventResult.accept;
                    }
                }

                // ---- DevTools panel -----------------------------------------
                // Bottom-docked over the page frame, and — exactly like the
                // context menu and the container manager — an in-window
                // overlay Rectangle, not a PopupWindow (the LinuxKMS backend
                // has no popups). Declared after the page's `ta` ⇒ on top of
                // it: the scrim swallows page clicks and wheel events while
                // the panel is open, and the ListView scrolls instead.
                Rectangle {
                    visible: root.devtools-open;
                    x: 0;
                    y: parent.height - self.height;
                    width: parent.width;
                    height: Math.min(240px, parent.height * 0.65);
                    background: #171717;
                    clip: true;
                    dt-scrim := TouchArea { }
                    // separator from the page above
                    Rectangle { x: 0; y: 0; width: parent.width; height: 1px; background: #4a4a4a; }

                    VerticalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        padding-bottom: 6px;
                        spacing: 4px;

                        // ---- header: pane buttons (with entry counts) + close
                        Rectangle {
                            height: 32px;
                            HorizontalLayout {
                                x: 0; width: parent.width; height: parent.height;
                                cross-axis-alignment: center;
                                spacing: 6px;
                                MiniButton {
                                    label: "Console" + (root.console-count > 0 ? " " + root.console-count : "");
                                    tint: root.devtools-view == 0 ? #3a3a3a : #262626;
                                    clicked => { root.devtools-select-view(0); }
                                }
                                MiniButton {
                                    label: "Network" + (root.network-count > 0 ? " " + root.network-count : "");
                                    tint: root.devtools-view == 1 ? #3a3a3a : #262626;
                                    clicked => { root.devtools-select-view(1); }
                                }
                                MiniButton {
                                    label: "Inspector" + (root.inspector-count > 0 ? " " + root.inspector-count : "");
                                    tint: root.devtools-view == 2 ? #3a3a3a : #262626;
                                    // a tree the tab had to cut short is said here too
                                    opacity: root.inspector-truncated ? 0.55 : 1.0;
                                    clicked => { root.devtools-select-view(2); }
                                }
                                // ⌖ *inspect element*: armed for the whole tab, so the
                                // button stays lit while the page swallows pointers for
                                // the picker (Ctrl-Shift-C is the same chord).
                                MiniButton {
                                    label: "⌖";
                                    tint: root.inspector-pick ? #7a4a1d : #262626;
                                    clicked => { root.devtools-toggle-pick(); }
                                }
                                Rectangle { horizontal-stretch: 1; }
                                MiniButton {
                                    label: "Clear";
                                    // Console / Network feeds only: the Inspector pane
                                    // has no feed of its own, its tree is the document.
                                    enabled: root.devtools-view != 2;
                                    clicked => { root.devtools-clear(); }
                                }
                                MiniButton { label: "✕"; clicked => { root.devtools-close(); } }
                            }
                        }

                        // ---- console view -------------------------------------
                        if root.devtools-view == 0: ListView {
                            vertical-stretch: 1;
                            for dtc[i] in root.console-rows: Rectangle {
                                height: 22px;
                                dtcbg := Rectangle { background: dtcta.has-hover ? #262626 : Math.mod(i, 2) == 0 ? transparent : #1b1b1b; }
                                Text {
                                    x: 8px;
                                    width: 18px;
                                    height: parent.height;
                                    text: root.devtools-level-icon(dtc.level);
                                    color: root.devtools-level-color(dtc.level);
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                Text {
                                    x: 30px;
                                    max-width: Math.max(0px, parent.width - 38px);
                                    height: parent.height;
                                    text: dtc.text;
                                    color: root.devtools-level-color(dtc.level);
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                dtcta := TouchArea { }
                            }
                        }

                        // ---- network view --------------------------------------
                        if root.devtools-view == 1: VerticalLayout {
                            vertical-stretch: 1;
                            spacing: 2px;
                            // column captions
                            Rectangle {
                                height: 20px;
                                head := NetRowCells {
                                    width: parent.width;
                                    height: parent.height;
                                    cell-color: #8a8a8a;
                                    method: "Method";
                                    url: "URL";
                                    initiator: "Initiator";
                                    status: "Status";
                                    bytes: "Size";
                                    time: "Time";
                                }
                            }
                            ListView {
                                vertical-stretch: 1;
                                for dtn[i] in root.net-rows: Rectangle {
                                    height: 22px;
                                    net-row-bg := Rectangle { background: netrowta.has-hover ? #262626 : Math.mod(i, 2) == 0 ? transparent : #1b1b1b; }
                                    NetRowCells {
                                        x: 0; y: 0;
                                        width: parent.width;
                                        height: parent.height;
                                        method: dtn.method;
                                        url: dtn.url;
                                        initiator: dtn.initiator;
                                        status: dtn.status;
                                        bytes: dtn.size;
                                        time: dtn.time;
                                        cell-color: dtn.failed ? #ef5350 : #cfcfcf;
                                        status-color: dtn.failed ? #ef5350 : #cfcfcf;
                                    }
                                    netrowta := TouchArea { }
                                }
                            }
                        }

                        // ---- Inspector view ------------------------------------
                        // Breadcrumb over the tree: `html › body › div#main`, the
                        // selected node's ancestor chain, every crumb clickable.
                        if root.devtools-view == 2: VerticalLayout {
                            vertical-stretch: 1;
                            spacing: 2px;
                            Rectangle {
                                height: 18px;
                                Text {
                                    x: 2px; width: parent.width; height: parent.height;
                                    text: root.inspector-summary;
                                    color: #8a8a8a; font-size: 12px;
                                    vertical-alignment: center; overflow: elide;
                                }
                            }
                            Rectangle {
                                height: root.inspector-crumb.length > 0 ? 22px : 0px;
                                HorizontalLayout {
                                    spacing: 3px;
                                    cross-axis-alignment: center;
                                    for ci[i] in root.inspector-crumb: Rectangle {
                                        width: crumb-inner.preferred-width + 8px;
                                        height: 20px;
                                        border-radius: 3px;
                                        crumb-bg := Rectangle {
                                            background: crumb-ta.has-hover ? #3a3a3a : transparent;
                                            border-radius: 3px;
                                        }
                                        crumb-inner := HorizontalLayout {
                                            padding-left: 3px; padding-right: 3px;
                                            spacing: 0px;
                                            Text {
                                                text: i > 0 ? "› " : "";
                                                color: #6a6a6a;
                                                vertical-alignment: center;
                                            }
                                            Text {
                                                text: ci.tag;
                                                color: root.inspect-kind-color(1);
                                                vertical-alignment: center;
                                            }
                                            Text {
                                                text: ci.ident;
                                                color: root.inspect-kind-color(8);
                                                vertical-alignment: center;
                                            }
                                        }
                                        crumb-ta := TouchArea {
                                            clicked => { root.devtools-select-node(ci.node); }
                                        }
                                    }
                                }
                            }
                            // The tree, or the reason there is none.
                            if root.inspector-empty: Rectangle {
                                height: 22px;
                                Text {
                                    x: 8px; width: parent.width; height: parent.height;
                                    text: root.inspector-hint;
                                    color: #6a6a6a; font-italic: true;
                                    vertical-alignment: center; overflow: elide;
                                }
                            }
                            if !root.inspector-empty: ListView {
                                vertical-stretch: 1;
                                for dr[i] in root.inspector-rows: Rectangle {
                                    height: 22px;
                                    dr-bg := Rectangle {
                                        background: dr-ta.has-hover ? #262626
                                                  : dr.selected ? #33260f
                                                  : Math.mod(i, 2) == 0 ? transparent : #1b1b1b;
                                    }
                                    // the row itself selects the node; the twisty is
                                    // declared above it and keeps its own click
                                    dr-ta := TouchArea {
                                        clicked => { root.devtools-select-node(dr.node); }
                                    }
                                    dr-tw := TouchArea {
                                        x: 6px + dr.depth * 12px;
                                        width: 16px;
                                        height: parent.height;
                                        visible: dr.twisty != "";
                                        clicked => { root.devtools-toggle-fold(dr.node); }
                                    }
                                    Text {
                                        x: 6px + dr.depth * 12px;
                                        width: 16px; height: parent.height;
                                        text: dr.twisty;
                                        color: #9a9a9a;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    HorizontalLayout {
                                        x: 22px + dr.depth * 12px;
                                        width: Math.max(0px, parent.width - 22px - dr.depth * 12px);
                                        height: parent.height;
                                        spacing: 0px;
                                        for dt in dr.toks: Text {
                                            text: dt.text;
                                            color: root.inspect-kind-color(dt.kind);
                                            font-italic: dr.italic;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                    }
                                }
                            }
                            // A snapshot the tab had to cut short says so, dim, last.
                            Rectangle {
                                height: root.inspector-truncated ? 20px : 0px;
                                Text {
                                    x: 8px; width: parent.width; height: parent.height;
                                    text: "\u{2026} the tree is bigger than the tab can send";
                                    color: #6a6a6a; font-italic: true;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                // ---- context menu -----------------------------------------
                // An in-page overlay, not a PopupWindow: the LinuxKMS backend
                // has no popups, so — exactly like the container manager —
                // the menu is drawn on top of the page frame. Declared after
                // `ta` ⇒ on top of it: the scrim swallows page clicks while
                // the menu is open, and every item row (declared later than
                // the scrim) keeps its own click.
                Rectangle {
                    visible: root.menu-open;
                    x: 0; y: 0;
                    width: parent.width; height: parent.height;
                    menu-scrim := TouchArea {
                        clicked => { root.menu-close(); }
                    }
                    Rectangle {
                        x: Math.max(2px, Math.min(root.menu-x, parent.width - self.width - 2px));
                        y: Math.max(2px, Math.min(root.menu-y, parent.height - self.height - 2px));
                        width: 232px;
                        height: menu-list.preferred-height + 10px;
                        background: #2a2a2a;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: #4a4a4a;
                        menu-list := VerticalLayout {
                            padding: 4px;
                            spacing: 1px;
                            for mi[i] in root.menu-items: Rectangle {
                                height: 26px;
                                mibgr := Rectangle {
                                    background: mita.has-hover ? #3d3d3d : transparent;
                                    border-radius: 4px;
                                }
                                mitxt := Text {
                                    text: mi.label;
                                    color: #e8e8e8;
                                    x: 10px;
                                    vertical-alignment: center;
                                    max-width: parent.width - 18px;
                                    overflow: elide;
                                }
                                mita := TouchArea {
                                    clicked => { root.menu-pick(i); }
                                }
                            }
                        }
                    }
                }
            }
        }

        // ---- status bar ------------------------------------------------------
        Rectangle {
            height: 24px;
            background: #2b2b2b;

            // ---- loading progress bar -----------------------------------------
            // Website loading progress, left-hand end of the status bar: a
            // recessed track with a brighter segment sweeping across it while
            // the active tab loads. The tab protocol reports loading as a
            // single bool (no byte counts), so the progress is honestly
            // indeterminate — the sweep *is* the progress.
            //
            // The rects sit *outside* the layout below, pinned to the track:
            // a layout gives its items no geometry until they have content,
            // and an always-empty Rectangle must never push the spinner text
            // off the left edge.
            load-track := Rectangle {
                x: 10px;
                y: (parent.height - self.height) / 2;
                width: 96px;
                height: 4px;
                visible: root.loading;
                border-radius: 2px;
                background: #3a3a3a;

                // The lit segment: a fixed-size (a quarter of the track)
                // window sliding from the left end to the right end and back.
                load-segment := Rectangle {
                    // 12 steps × 4 px = the 96 px track; the track's own
                    // border-radius keeps the segment's corners round when it
                    // sits at either end.
                    x: root.load-progress * 4px;
                    width: Math.min(24px, parent.width - root.load-progress * 4px);
                    height: parent.height;
                    background: #5b9dd9;
                    border-radius: 2px;
                }
            }

            HorizontalLayout {
                x: 10px;
                height: parent.height;
                cross-axis-alignment: center;
                spacing: 8px;

                // The bar owns the left edge: while it is up the text column
                // starts after it instead of under it.
                Rectangle { width: root.loading ? 106px : 0px; height: 1px; }
                Text { text: root.spinner; color: #bbbbbb; }
                Text { text: root.sec-glyph; color: root.sec-color; }
                st := Text {
                    text: root.status-text;
                    color: #aaaaaa;
                    vertical-alignment: center;
                    max-width: Math.max(0px, root.width - 220px);
                    overflow: elide;
                }
            }
        }
    }

    // ------------------------------------------------------------------------
    // JS dialog overlay (window.alert / confirm / prompt)
    //
    // An in-window overlay like the manager and the context menu (LinuxKMS
    // has no popups), declared after the page ⇒ above every page overlay
    // including the DevTools panel: while a dialog is open its scrim
    // swallows every click on the page, matching a real modal — and the tab
    // process is blocked on the answer anyway, so the page cannot act.
    // ------------------------------------------------------------------------
    Rectangle {
        x: 0; y: 0;
        width: root.width; height: root.height;
        visible: root.dialog-open;
        background: #00000066;
        dialog-scrim := TouchArea { }

        dialog-panel := Rectangle {
            x: (root.width - self.width) / 2;
            y: Math.max(24px, (root.height - self.height) / 2);
            width: Math.min(440px, root.width - 48px);
            height: dialog-body.preferred-height + 36px;
            background: #242424;
            border-radius: 8px;
            border-width: 1px;
            border-color: #565656;
            // clicks on the panel itself must not fall through to the scrim
            panel-ta := TouchArea { }

            dialog-body := VerticalLayout {
                padding: 16px;
                spacing: 10px;

                Text {
                    text: root.dialog-title;
                    color: #a8b8c8;
                    font-size: 12px;
                }
                Text {
                    text: root.dialog-message;
                    color: #ececec;
                    wrap: word-wrap;
                    horizontal-alignment: left;
                }
                if root.dialog-kind == 2: LineEdit {
                    text <=> root.dialog-input;
                    placeholder-text: "Enter text";
                    accepted => { root.dialog-accept(); }
                }
                Rectangle {
                    height: 28px;
                    HorizontalLayout {
                        x: 0; width: parent.width; height: parent.height;
                        spacing: 8px;
                        alignment: end;
                        MiniButton { label: "Cancel"; visible: root.dialog-kind != 0; clicked => { root.dialog-cancel(); } }
                        MiniButton { label: "OK"; clicked => { root.dialog-accept(); } }
                    }
                }
            }
        }
    }

    // ------------------------------------------------------------------------
    // find-in-page bar (Ctrl-F): floats over the top-right corner of the page,
    // declared after the page ⇒ above it (and above the DevTools panel), but
    // before the modal overlays, which must keep covering everything.
    // ------------------------------------------------------------------------
    find-bar := FindBar {
        x: page-frame.absolute-position.x + page-frame.width - self.width - 16px;
        y: page-frame.absolute-position.y + 8px;
        visible: root.find-open;
        focus-token: root.find-focus-token;
        count: root.find-count;
        text <=> root.find-text;
        query-changed(q) => { root.find-query-changed(q); }
        next() => { root.find-next(); }
        previous() => { root.find-previous(); }
        close() => { root.find-close(); }
    }

    // ------------------------------------------------------------------------
    // container manager overlay
    // ------------------------------------------------------------------------
    Rectangle {
        x: 0; y: 0;
        width: root.width; height: root.height;
        visible: root.manager-open;
        background: #00000099;
        scrim := TouchArea { clicked => { root.close-manager(); } }

        panel := Rectangle {
            TouchArea {} // swallow clicks over the panel
            x: root.width - self.width;
            width: Math.min(380px, root.width);
            height: root.height;
            background: #1e1e1e;

            VerticalLayout {
                padding: 12px;
                spacing: 6px;

                HorizontalLayout {
                    spacing: 8px;
                    height: 26px;
                    Text { text: "Containers"; color: #f0f0f0; font-weight: 600; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    MiniButton { label: "✕"; clicked => { root.close-manager(); } }
                }

                for c[i] in containers: Rectangle {
                    height: 54px;
                    width: parent.width;
                    sel := Rectangle { background: i == root.selected-container ? #383838 : #262626; border-radius: 4px; }
                    // declared before the content ⇒ bottom z-order: clicking
                    // anywhere on the row still selects it, but the New/Move
                    // tab/Delete/Ren buttons (declared on top) keep receiving
                    // their clicks — a TouchArea declared last swallowed all
                    // of them, which is why "New" only ever re-selected.
                    selta := TouchArea { clicked => { root.mgr-select(i); } }
                    VerticalLayout {
                        x: 6px; y: 3px;
                        width: parent.width - 12px;
                        spacing: 2px;
                        HorizontalLayout {
                            height: 22px;
                            spacing: 6px;
                            Rectangle { width: 12px; height: 12px; border-radius: 3px; background: c.color; }
                            if i == root.editing-index: LineEdit {
                                horizontal-stretch: 1;
                                text: root.container-edit-text;
                                edited(t) => { root.container-edit-text = t; }
                                accepted => { root.mgr-rename(i); }
                            }
                            Text {
                                visible: i != root.editing-index;
                                text: c.name + (c.isDefault ? " ★" : "");
                                color: #e8e8e8;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            MiniButton { visible: i != root.editing-index; label: "Ren"; clicked => { root.mgr-start-rename(i); } }
                            MiniButton { visible: i == root.editing-index; label: "OK"; clicked => { root.mgr-rename(i); } }
                        }
                        HorizontalLayout {
                            height: 22px;
                            spacing: 6px;
                            MiniButton { label: "New"; clicked => { root.mgr-new-tab-in(i); } }
                            MiniButton { label: "Move tab"; clicked => { root.mgr-move-tab-to(i); } }
                            MiniButton {
                                label: "Delete";
                                enabled: !c.isDefault;
                                clicked => { root.mgr-delete(i); }
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }
                    }
                }

                Text { text: "Add container"; color: #f0f0f0; }
                HorizontalLayout {
                    height: 26px;
                    spacing: 6px;
                    LineEdit {
                        horizontal-stretch: 1;
                        text: root.container-edit-text;
                        edited(t) => { root.container-edit-text = t; }
                        placeholder-text: "name";
                        accepted => { root.mgr-add(); }
                    }
                    MiniButton { label: "Add"; clicked => { root.mgr-add(); } }
                }
                HorizontalLayout {
                    height: 20px;
                    spacing: 6px;
                    for p in [0, 1, 2, 3, 4, 5, 6]: Rectangle {
                        width: 18px; height: 18px; border-radius: 4px;
                        background: root.palette-color(p);
                        pt := TouchArea { clicked => { root.mgr-recolor(root.selected-container, p); } }
                    }
                }

                Rectangle { vertical-stretch: 1; }
                Text {
                    text: "Move tab re-spawns the active tab in the selected container (keeping its URL). Delete wipes that container's data. The palette recolors the selected container.";
                    color: #888888;
                    wrap: word-wrap;
                }
            }
        }
    }

    // ------------------------------------------------------------------------
    // userscript menu overlay (task: userscript menu)
    //
    // Exactly like the container manager above and never a PopupWindow (LinuxKMS
    // has no popups): a right-docked Rectangle over everything, its scrim a
    // TouchArea that closes the menu. Declared last ⇒ on top of the manager too
    // — and Rust closes one when the other opens, so they never stack.
    // ------------------------------------------------------------------------
    Rectangle {
        x: 0; y: 0;
        width: root.width; height: root.height;
        visible: root.us-menu-open;
        background: #00000099;
        us-scrim := TouchArea { clicked => { root.close-us-menu(); } }

        us-panel := Rectangle {
            TouchArea {} // swallow clicks over the panel
            x: root.width - self.width;
            width: Math.min(420px, root.width);
            height: root.height;
            background: #1e1e1e;

            VerticalLayout {
                padding: 12px;
                spacing: 6px;

                HorizontalLayout {
                    spacing: 8px;
                    height: 26px;
                    Text { text: "Userscripts"; color: #f0f0f0; font-weight: 600; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    MiniButton { label: "✕"; clicked => { root.close-us-menu(); } }
                }

                // one-line validation feedback (a failed Save keeps the editor up)
                Text {
                    visible: root.us-error != "";
                    text: root.us-error;
                    color: #ef5350;
                    wrap: word-wrap;
                }

                for us[i] in root.us-scripts: Rectangle {
                    height: 44px;
                    width: parent.width;
                    usbg := Rectangle { background: usa.has-hover ? #2c2c2c : #262626; border-radius: 4px; }
                    // declared before the content ⇒ bottom z-order: the row still
                    // highlights on hover, but the CheckBox and ✕ (declared on top)
                    // receive their clicks — a TouchArea declared last swallowed all
                    // of them, so toggling and deleting did nothing (same trap the
                    // container-manager rows above already fell into).
                    // Clicking anywhere else on the row edits the script: the
                    // text/layout items above are click-transparent, so their
                    // clicks land here and round-trip to `us-edit(idx)`.
                    usa := TouchArea {
                        clicked => { root.us-edit(i); }
                    }
                    HorizontalLayout {
                        x: 6px; y: 3px;
                        width: parent.width - 12px;
                        spacing: 8px;
                        cross-axis-alignment: center;
                        // the enable/disable toggle, bound to the stored flag;
                        // Rust persists through the Store at once and re-broadcasts
                        CheckBox {
                            checked: us.enabled;
                            toggled => { root.us-toggle(i); }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 0px;
                            Text {
                                text: us.name;
                                color: #e8e8e8;
                                font-weight: 600;
                                horizontal-alignment: left;
                                overflow: elide;
                            }
                            Text {
                                text: us.patterns;
                                color: #8a8a8a;
                                font-size: 11px;
                                horizontal-alignment: left;
                                overflow: elide;
                            }
                        }
                        MiniButton { label: "✕"; clicked => { root.us-delete(i); } }
                    }
                }

                if root.us-scripts.length == 0 && !root.us-editing: Text {
                    text: "No userscripts yet — add one below. Enabled scripts run on matching pages; disabled ones are never sent to a tab.";
                    color: #888888;
                    wrap: word-wrap;
                }

                Rectangle { vertical-stretch: 1; }

                // ---- footer: "+ New script" and the inline editor ----------
                if !root.us-editing: HorizontalLayout {
                    height: 28px;
                    spacing: 6px;
                    MiniButton { label: "+ New script"; clicked => { root.us-new(); } }
                }
                if root.us-editing: VerticalLayout {
                    spacing: 6px;
                    Text {
                        text: root.us-editing-existing ? "Edit userscript" : "New userscript";
                        color: #f0f0f0;
                        font-weight: 600;
                    }
                    LineEdit {
                        height: 26px;
                        text <=> root.us-name;
                        placeholder-text: "name";
                    }
                    LineEdit {
                        height: 26px;
                        text <=> root.us-patterns;
                        placeholder-text: "URL patterns (comma or space separated, * wildcards ok)";
                    }
                    // multi-line code editor: the builtin TextInput with
                    // single-line off (a LineEdit would flatten the script)
                    Rectangle {
                        height: Math.min(160px, Math.max(120px, parent.width * 0.35));
                        background: #141414;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: #3a3a3a;
                        clip: true;
                        us-code-focus := FocusScope {
                            width: parent.width; height: parent.height;
                            TextInput {
                                width: parent.width;
                                height: parent.height;
                                single-line: false;
                                wrap: word-wrap;
                                font-size: 12px;
                                color: #e8e8e8;
                                text <=> root.us-code;
                            }
                        }
                    }
                    HorizontalLayout {
                        height: 28px;
                        spacing: 8px;
                        MiniButton { label: "Save"; clicked => { root.us-save(); } }
                        MiniButton { label: "Cancel"; clicked => { root.us-cancel(); } }
                        Rectangle { horizontal-stretch: 1; }
                    }
                }
            }
        }
    }

    // ------------------------------------------------------------------------
    // User-Agent switcher overlay (task: per-container UA)
    //
    // Exactly like the userscript menu above and the container manager before
    // it — a right-docked Rectangle (never a PopupWindow: LinuxKMS has none),
    // its scrim a TouchArea that closes the menu. Declared last ⇒ on top of
    // both; Rust closes those when this opens (and vice versa), so no two of
    // the three ever stack. The menu targets the *active tab's container*.
    // ------------------------------------------------------------------------
    Rectangle {
        x: 0; y: 0;
        width: root.width; height: root.height;
        visible: root.ua-menu-open;
        background: #00000099;
        ua-scrim := TouchArea { clicked => { root.close-ua-menu(); } }

        ua-panel := Rectangle {
            TouchArea {} // swallow clicks over the panel
            x: root.width - self.width;
            width: Math.min(420px, root.width);
            height: root.height;
            background: #1e1e1e;

            VerticalLayout {
                padding: 12px;
                spacing: 6px;

                HorizontalLayout {
                    spacing: 8px;
                    height: 26px;
                    Text { text: "User-Agent"; color: #f0f0f0; font-weight: 600; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    MiniButton { label: "✕"; clicked => { root.close-ua-menu(); } }
                }

                // the container's live value ("Default (IronSurf)" / a preset
                // name / "Custom"), re-pushed after every mutation
                Text {
                    text: "Current: " + root.ua-current;
                    color: #a8b8c8;
                    wrap: word-wrap;
                }

                // one-line validation feedback (a rejected Apply keeps the draft)
                Text {
                    visible: root.ua-error != "";
                    text: root.ua-error;
                    color: #ef5350;
                    wrap: word-wrap;
                }

                for ua[i] in root.ua-rows: Rectangle {
                    height: 26px;
                    width: parent.width;
                    // the active row is highlighted; declared before the text
                    // ⇒ bottom z-order, so its TouchArea still receives the
                    // click the layout above lets through (the trap the
                    // container-manager and userscript rows already fell into).
                    uabg := Rectangle {
                        background: ua.active ? #3a3a3a : uata.has-hover ? #2c2c2c : #262626;
                        border-radius: 4px;
                    }
                    uata := TouchArea {
                        clicked => { root.ua-select(i); }
                    }
                    Text {
                        x: 10px;
                        max-width: parent.width - 32px;
                        height: parent.height;
                        text: ua.label + (ua.active ? "  ✓" : "");
                        color: ua.active ? #f0f0f0 : #c8c8c8;
                        font-weight: ua.active ? 600 : 400;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }

                Rectangle { vertical-stretch: 1; }

                // ---- footer: copy / restore / custom editor ---------------
                HorizontalLayout {
                    height: 28px;
                    spacing: 6px;
                    MiniButton { label: "Copy"; clicked => { root.ua-copy(); } }
                    MiniButton { label: "Restore default"; clicked => { root.ua-restore-default(); } }
                    Rectangle { horizontal-stretch: 1; }
                }
                HorizontalLayout {
                    height: 28px;
                    spacing: 6px;
                    LineEdit {
                        horizontal-stretch: 1;
                        text <=> root.ua-custom;
                        placeholder-text: "custom User-Agent string";
                        accepted(t) => { root.ua-apply-custom(t); }
                    }
                    MiniButton { label: "Apply"; clicked => { root.ua-apply-custom(root.ua-custom); } }
                }
                Text {
                    text: "The choice is persisted for this container and sent to its live tabs; tabs in other containers keep their own User-Agent. New tabs of this container start with it.";
                    color: #888888;
                    wrap: word-wrap;
                }
            }
        }
    }

    // ------------------------------------------------------------------------
    // Archive-mode overlay (task: archive mode)
    //
    // The same right-docked Rectangle as the other three menus (never a
    // PopupWindow: LinuxKMS has none), opened by the 💾 toolbar button and
    // never stacked — Rust closes it when any other menu opens, and closes
    // the others when this one opens.
    // ------------------------------------------------------------------------
    Rectangle {
        x: 0; y: 0;
        width: root.width; height: root.height;
        visible: root.archive-menu-open;
        background: #00000099;
        archive-scrim := TouchArea { clicked => { root.close-archive-menu(); } }

        archive-panel := Rectangle {
            TouchArea {} // swallow clicks over the panel
            x: root.width - self.width;
            width: Math.min(420px, root.width);
            height: root.height;
            background: #1e1e1e;

            VerticalLayout {
                padding: 12px;
                spacing: 6px;

                HorizontalLayout {
                    spacing: 8px;
                    height: 26px;
                    Text { text: "\u{1F4BE} Archive mode"; color: #f0f0f0; font-weight: 600; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    MiniButton { label: "✕"; clicked => { root.close-archive-menu(); } }
                }

                CheckBox {
                    text: "Save every visited site and every file it loads";
                    checked <=> root.archive-enabled;
                    // `toggled` fires after the checkbox flipped `checked`,
                    // so the property already carries the wanted state.
                    toggled => { root.archive-set-enabled(root.archive-enabled); }
                }

                // one-line live status (effective root + files saved so far)
                Text {
                    text: root.archive-status;
                    color: #a8b8c8;
                    wrap: word-wrap;
                }

                // one-line validation feedback (a rejected Apply keeps the draft)
                Text {
                    visible: root.archive-error != "";
                    text: root.archive-error;
                    color: #ef5350;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    height: 28px;
                    spacing: 6px;
                    LineEdit {
                        horizontal-stretch: 1;
                        text <=> root.archive-dir-text;
                        placeholder-text: "archive folder (default: ~/Downloads/ironsurf-tabs)";
                        accepted(t) => { root.archive-apply-dir(t); }
                    }
                    MiniButton { label: "Apply"; clicked => { root.archive-apply-dir(root.archive-dir-text); } }
                }

                Rectangle { vertical-stretch: 1; }

                Text {
                    text: "While on, every page (saved as <host>/index.html), script, style, image, and media file the tabs load is written under <folder>/<timestamp of the tab's start>/<host>/… . Each tab process gets its own timestamp folder, so nothing an earlier run saved is ever overwritten by a later one. Folders are created on demand; failures are logged, never fatal.";
                    color: #888888;
                    wrap: word-wrap;
                }
            }
        }
    }
}
